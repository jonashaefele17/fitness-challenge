# Frontend (Vite). Both values are public and end up in the bundle.
# Local development: values printed by `npm run db:start` (API URL + publishable key).
# Staging/live builds: set as GitHub environment variables, not here.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Base path the app is served from. "/" locally, "/fitness-challenge/" on GitHub Pages.
VITE_BASE_PATH=/
